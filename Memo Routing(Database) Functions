/**
 * A high-performance function to check approval statuses across multiple sheets for very large datasets.
 * It uses a caching strategy to minimize API calls and process data in memory.
 *
 * How it works:
 * 1.  Caches Data: It first loops through all potential source sheets ('GMC', 'RCS', etc.) and reads
 *     their key data (Column J for lookup, Column A for status) into an efficient JavaScript Map.
 *     This is done only once.
 * 2.  Reads Main Sheet: It reads the entire relevant data range from the main "Conso" sheet in one go.
 * 3.  Processes in Memory: It loops through the "Conso" data *in memory*, using the cached Maps for
 *     instant lookups. This avoids any spreadsheet API calls inside the main loop.
 * 4.  Writes in Bulk: It collects all the calculated final statuses and writes them back to Column A
 *     in a single `setValues()` operation, which is dramatically faster than writing cell-by-cell.
 */
function checkApprovalStatus_Optimized() {
  const ss = SpreadsheetApp.getActiveSpreadsheet();
  const mainSheetName = "Conso"; // It's better to reference the sheet by name for clarity
  const sheet = ss.getSheetByName(mainSheetName);

  if (!sheet) {
    SpreadsheetApp.getUi().alert(`Sheet "${mainSheetName}" not found!`);
    return;
  }
  
  // Start a timer to measure performance
  console.time("Execution Time");

  try {
    const lastRow = sheet.getLastRow();
    if (lastRow < 2) {
      console.log("No data to process.");
      return; // No data
    }

    // --- Define Your Configuration ---
    const validSheets = ["GMC", "RCS", "MGL", "KMV", "LDA", "JAYE", "BRIX", "JOY", "ALEX", "AU", "MAR", "EBA", "DSM", "JAC", "DP", "FA", "DM", "KL", "JM", "JG", "MA", "ANNALEE", "ARRA", "DULCE", "AIZELLE", "VIA", "OAUIE", "MICH", "FATIMA", "MELANIE", "STEPH", "PAT", "ROSA", "JANICE", "CAMSY", "MIKEE", "VAN", "TYRON"];
    const coreSheets = ["GMC", "MGL", "RCS", "KMV", "LDA", "CAMSY", "MIKEE", "VAN", "TYRON"];
    
    // --- STEP 1: CACHE DATA FROM ALL SOURCE SHEETS ---
    console.log("Caching data from source sheets...");
    const sheetDataCache = {}; // This will hold our data: { sheetName: Map(lookupValue -> status), ... }

    for (const sheetName of validSheets) {
      const targetSheet = ss.getSheetByName(sheetName);
      if (!targetSheet) {
        console.warn(`Sheet "${sheetName}" not found. Skipping.`);
        continue;
      }

      // Get all data from columns A and J in one read operation
      const targetLastRow = targetSheet.getLastRow();
      if (targetLastRow < 2) continue; // Skip empty sheets

      const targetData = targetSheet.getRange(1, 1, targetLastRow, 10).getValues(); // A to J

      // Create a fast lookup map for this sheet
      const lookupMap = new Map();
      // Start from row 1 to skip header if it exists
      for (let i = 1; i < targetData.length; i++) {
        const lookupValue = targetData[i][9]; // Column J (index 9)
        const statusValue = targetData[i][0]; // Column A (index 0)
        if (lookupValue) { // Only add if lookup value is not empty
          lookupMap.set(lookupValue, statusValue);
        }
      }
      sheetDataCache[sheetName] = lookupMap;
    }
    console.log("Caching complete.");

    // --- STEP 2: READ MAIN SHEET DATA ---
    // Read all the data we need from the main sheet in one go
    console.log(`Reading data from "${mainSheetName}"...`);
    const mainDataRange = sheet.getRange(2, 1, lastRow - 1, 80); // Columns A to BX (Col 1 to 80)
    const mainData = mainDataRange.getValues();
    const finalStatuses = []; // This array will hold the new values for column A

    // --- STEP 3: PROCESS DATA IN MEMORY ---
    console.log("Processing data in memory...");
    for (let i = 0; i < mainData.length; i++) {
      const currentRow = mainData[i];
      const currentStatus = currentRow[0]; // Value from Column A (index 0)

      // If status is 'APPROVED' or 'DISAPPROVED', skip the check.
      if (currentStatus === "APPROVED" || currentStatus === "DISAPPROVED") {
        finalStatuses.push([currentStatus]); // Keep the existing status
        continue; // Move to the next row
      }

      const val = currentRow[4]; // Value from Column E (now at index 4)
      if (!val) {
        finalStatuses.push([""]); // Keep cell empty if E is empty
        continue;
      }
      
      const sheetRowRefs = currentRow.slice(14, 80); // Sheet refs from O to BX (now index 14 to 79)
      
      // Filter sheets based on this row's references
      const availableSheets = validSheets.filter(s => sheetRowRefs.includes(s));
      const existingCoreSheets = coreSheets.filter(s => availableSheets.includes(s));
      
      // Get results using the super-fast cached maps
      const allResults = availableSheets.map(sheetName => {
        const lookupMap = sheetDataCache[sheetName];
        // Use the map to get the status. If not found, return empty string.
        return (lookupMap && lookupMap.has(val)) ? lookupMap.get(val) : "";
      });

      const coreResults = existingCoreSheets.map(sheetName => {
        const lookupMap = sheetDataCache[sheetName];
        return (lookupMap && lookupMap.has(val)) ? lookupMap.get(val) : "";
      });

      // --- Apply the approval logic ---
      const disapprovedCount = allResults.filter(res => res === "DISAPPROVED").length;
      const approvedCoreCount = coreResults.filter(res => res === "APPROVED").length;
      const totalCoreCount = existingCoreSheets.length;

      // === START: NEW LOGIC ===
      // Get the status specifically from the GMC sheet cache to check it first.
      const gmcStatus = (sheetDataCache["GMC"] && sheetDataCache["GMC"].has(val)) ? sheetDataCache["GMC"].get(val) : "";
      // === END: NEW LOGIC ===

      let finalStatus = "";
      if (disapprovedCount > 0) {
        finalStatus = "DISAPPROVED";
      } 
      // === START: NEW CONDITION ===
      // If no disapprovals, check if GMC is approved. If so, set final status to APPROVED.
      else if (gmcStatus === "APPROVED") {
        finalStatus = "APPROVED";
      } 
      // === END: NEW CONDITION ===
      else if (totalCoreCount > 0) {
        // This block now only runs if there are no disapprovals AND GMC is not approved.
        finalStatus = (approvedCoreCount === totalCoreCount) ? "APPROVED" : "PENDING";
      } else {
        // Handle case where there are no "core" sheets available for this row, but maybe others
        const allPending = allResults.every(res => res === "PENDING" || res === "");
        const anyApproved = allResults.some(res => res === "APPROVED");
        if (!anyApproved && allPending) {
             finalStatus = "PENDING";
        } else if (allResults.length > 0 && allResults.every(res => res === "APPROVED")) {
             // Optional: If you want non-core to also trigger approval if all are approved
             finalStatus = "APPROVED";
        } else {
             finalStatus = "PENDING";
        }
      }
      
      finalStatuses.push([finalStatus]); // Add to our results array
    }

    // --- STEP 4: WRITE DATA IN BULK ---
    if (finalStatuses.length > 0) {
      console.log("Writing results back to the sheet...");
      sheet.getRange(2, 1, finalStatuses.length, 1).setValues(finalStatuses);
      console.log("Update complete!");
    } else {
      console.log("No results to write.");
    }
    
  } catch (e) {
    // Log any errors that occur
    console.error(`An error occurred: ${e.message}\nStack: ${e.stack}`);
    SpreadsheetApp.getUi().alert(`An error occurred. Check logs for details. Error: ${e.message}`);
  } finally {
    // Log the total time taken
    console.timeEnd("Execution Time");
  }
}

