/**
 * Scans the 'Conso' sheet to find rows where 'Graham Coates' is the sole pending person,
 * and sends an automated email notification for each match.
 */
function findAndEmailPendingMemos() {
  // --- Configuration ---
  const sheetName = 'Conso';
  const targetName = 'Graham Coates';
  const primaryColumnLetter = 'CM';   // Column with the "Pending:" status
  const recipientCol1Letter = 'H';    // First email recipient column
  const recipientCol2Letter = 'J';    // Second email recipient column
  const subjectPart1ColLetter = 'E';  // For the subject line (e.g., REF#)
  const subjectPart2ColLetter = 'K';  // For the subject line (e.g., Memo Title)
  // --- End of Configuration ---

  try {
    const spreadsheet = SpreadsheetApp.getActiveSpreadsheet();
    const sheet = spreadsheet.getSheetByName(sheetName);

    if (!sheet) {
      console.error(`ERROR: The sheet named '${sheetName}' could not be found.`);
      return;
    }

    const allValues = sheet.getDataRange().getValues();

    // Get the column index numbers from their letters to make the script robust.
    const primaryColIndex = sheet.getRange(primaryColumnLetter + "1").getColumn() - 1;
    const recipientCol1Index = sheet.getRange(recipientCol1Letter + "1").getColumn() - 1;
    const recipientCol2Index = sheet.getRange(recipientCol2Letter + "1").getColumn() - 1;
    const subjectPart1Index = sheet.getRange(subjectPart1ColLetter + "1").getColumn() - 1;
    const subjectPart2Index = sheet.getRange(subjectPart2ColLetter + "1").getColumn() - 1;

    console.log(`--- Starting search for memos pending only for '${targetName}' ---`);
    let emailsSentCount = 0;

    for (let i = 0; i < allValues.length; i++) {
      const rowData = allValues[i];
      const primaryValue = rowData[primaryColIndex]; // Value from Col CM

      if (typeof primaryValue !== 'string' || !primaryValue.includes('Pending:')) {
        continue; // Skip if cell is not text or doesn't contain "Pending:"
      }

      const pendingNames = primaryValue.split('Pending:')[1];
      if (!pendingNames) {
        continue; // Skip if there's nothing after "Pending:"
      }

      // --- The Core Filter Condition ---
      if (pendingNames.trim() === targetName) {
        const rowNumber = i + 1;
        console.log(`Row ${rowNumber}: Match found. Preparing to send email.`);

        // 1. Gather Recipients
        const email1 = rowData[recipientCol1Index];
        const email2 = rowData[recipientCol2Index];
        const recipients = [email1, email2].filter(email => email && email.includes('@')).join(',');

        if (!recipients) {
          console.error(`Row ${rowNumber}: Match found, but no valid email addresses were found in columns ${recipientCol1Letter} or ${recipientCol2Letter}. Skipping.`);
          continue;
        }

        // 2. Construct Subject
        const subjectPart1 = rowData[subjectPart1Index] || 'N/A'; // Default value if cell is empty
        const subjectPart2 = rowData[subjectPart2Index] || 'N/A';
        const subject = `${subjectPart1} - ${subjectPart2}`;

        // 3. Construct Email Body (with enhanced grammar)
        const body = `
          <p>Good day,</p>
          <p>The memo has been cleared by all reviewers and pre-approvers and is now pending with GMC.</p>
          <p>This serves as a reminder to please forward the hardcopy of the memo, with the GM's signature, to the GMC Office.</p>
          <p>Please disregard this message if the memo has already been transmitted.</p>
          <p>Thank you.</p>
          <br>
          <i>This is an automated notification.</i>
        `;

        // 4. Send the Email
        try {
          GmailApp.sendEmail(recipients, subject, '', { htmlBody: body });
          console.log(`Row ${rowNumber}: Email successfully sent to ${recipients}.`);
          emailsSentCount++;
        } catch (emailError) {
          console.error(`Row ${rowNumber}: Failed to send email to ${recipients}. Error: ${emailError.message}`);
        }
      }
    }

    if (emailsSentCount === 0) {
      console.log(`INFO: No rows were found where '${targetName}' was the only pending person.`);
    } else {
      console.log(`SUCCESS: Process finished. A total of ${emailsSentCount} email(s) were sent.`);
    }

    console.log("--- End of process ---");

  } catch (e) {
    console.error(`A critical error occurred: ${e.message}`);
  }
}






