function processAllReviewerSheets() {
  const ss = SpreadsheetApp.getActiveSpreadsheet();
  // The following line was removed as it causes an error with time triggers.
  // SpreadsheetApp.getUi().alert('Processing Started', 'This may take a moment. You will be notified when it is complete.', SpreadsheetApp.getUi().ButtonSet.OK);

  // Define the reviewers and their full names
  const reviewers = ["GMC", "RCS", "MGL", "JE", "NOE", "KMV", "LDA", "JAYE", "BRIX", "JOY", "ALEX", "AU", "MAR", "EBA", "DSM", "JAC", "DP", "FA", "DM", "KL", "JM", "JG", "MA", "ANNALEE", "ARRA", "DULCE", "AIZELLE", "VIA", "OAUIE", "MICH", "FATIMA", "MELANIE", "STEPH", "PAT", "ROSA", "JANICE", "CAMSY", "MIKEE", "VAN", "TYRON"];
  const names = ["Graham Coates", "Rosalyn Segura", "Michael Lao", "Jeremy Rodriguez", "Noe Versoza", "Tinay Villanueva", "Lorence Aurello", "Jaye Trich Pizarro", "Brix Valdenarro", "Joy Melitante", "Alex Flores", "Aurora Pastolero", "Mariano Caleja", "Ernesto Andrade", "Dustin Sta. Maria", "Jenel Ann Cruzgarcia", "Doreen Penilla", "Frances Armian", "Denisse Malong", "Kevin Lin", "Juvi Masilungan", "Jhoanalyn Gatdula", "Mary Arceo", "Annalee Pine", "Arralen Batallones", "Ma Dulce Cuenca", "Aizelle Anne Yalong", "Henedina Viado", "Oauie Banagan", "Michelle Ong", "Ma Fatima Bausin", "Melanie Lingon", "Stephen Sumilang", "Patricia Mari Quierez", "Rosa Cecilia Salvador", "Janice Cadog", "Camsy Elvina", "Mikee Vivo", "Vanessa Vicente", "Tyrone Tan"];

  // --- 1. PRE-LOADING PHASE ---
  const reviewerDataCache = {};
  reviewers.forEach(sheetName => {
    const sheet = ss.getSheetByName(sheetName);
    if (sheet) {
      const lastRow = sheet.getLastRow();
      if (lastRow === 0) return;
      const data = sheet.getRange(1, 1, lastRow, 10).getValues();
      const mappedData = {};
      for (const row of data) {
        const id = row[9];
        if (id && !mappedData.hasOwnProperty(id)) {
          mappedData[id] = { status: row[0], remarks: row[1], date: row[2] };
        }
      }
      reviewerDataCache[sheetName] = mappedData;
    }
  });

  // --- 2. PROCESSING & WRITING PHASE ---
  reviewers.forEach(sheetNameToProcess => {
    const currentSheet = ss.getSheetByName(sheetNameToProcess);
    if (!currentSheet) {
      console.log(`Skipping sheet "${sheetNameToProcess}" because it was not found.`);
      return;
    }

    const lastRow = currentSheet.getLastRow();
    if (lastRow < 2) return;

    const idRange = currentSheet.getRange(`${ID_COLUMN}2:${ID_COLUMN}${lastRow}`).getValues();
    const outputData = [];

    idRange.forEach(row => {
      const referenceId = row[0];
      if (!referenceId) {
        outputData.push(['']);
        return;
      }

      let approvers = [];
      let pendings = [];

      reviewers.forEach((sheetName, index) => {
        const reviewerName = names[index];
        const sheetData = reviewerDataCache[sheetName];

        if (sheetData && sheetData[referenceId]) {
          const match = sheetData[referenceId];
          const status = match.status;

          if (status && typeof status === 'string' && status.trim().toLowerCase() === 'approved') {
            const date = match.date ? new Date(match.date) : null;
            const formattedDate = date ? Utilities.formatDate(date, ss.getSpreadsheetTimeZone(), "MMM d, yyyy") : "";
            approvers.push(`${reviewerName} (Remarks: ${match.remarks}, Date: ${formattedDate})`);
          } else if (status === '') {
            pendings.push(reviewerName);
          }
        }
      });
      
      const approversString = approvers.join(", ");
      const pendingsString = pendings.join(", ");
      const finalString = "Approved: " + approversString + " Pending: " + pendingsString;
      
      outputData.push([finalString]);
    });

    if (outputData.length > 0) {
      currentSheet.getRange(`${TARGET_COLUMN}2:${TARGET_COLUMN}${lastRow}`).setValues(outputData);
    }
  });

  // The following line was removed as it causes an error with time triggers.
  // SpreadsheetApp.getUi().alert('Success!', 'All reviewer sheets have been updated.', SpreadsheetApp.getUi().ButtonSet.OK);
  console.log('All reviewer sheets have been updated successfully.'); // Optional: Log completion for debugging.
}

