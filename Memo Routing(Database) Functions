      // The paste starts at Column F (column index 6)
      destinationSheet.getRange(targetRow, 6, dataToWrite.length, dataToWrite[0].length).setValues(dataToWrite);
      
      Logger.log('SUCCESS: Wrote ' + dataToWrite.length + ' rows and ' + dataToWrite[0].length + ' columns to sheet "' + destinationSheetName + '".');

    } else {
      Logger.log('INFO: No new data to write for "' + filterValue + '". Sheet remains clear.');
    }
    Logger.log('--- Finished processing for: "' + filterValue + '" ---\n');
  }
}



