/**
 * Main function to generate approval PDFs based on defined conditions.
 * THIS IS THE FUNCTION YOUR TRIGGER SHOULD CALL.
 */
function approvesda() {
  const ss = SpreadsheetApp.getActiveSpreadsheet();
  const mainSheet = ss.getSheetByName(CONFIG.sheetNames.main);
  if (!mainSheet) {
    Logger.log(`Error: Main sheet "${CONFIG.sheetNames.main}" not found.`);
    return;
  }
  
  const mainData = mainSheet.getDataRange().getValues();
  
  // --- PERFORMANCE BOOST: Pre-load all data from approver sheets ---
  Logger.log("Pre-loading all approver data. This may take a moment...");
  const approverDataMap = preloadApproverData(ss, Object.keys(CONFIG.approverDetails));
  Logger.log("Pre-loading complete.");

  // Loop through all data rows, skipping the header.
  for (let i = 1; i < mainData.length; i++) {
    const rowData = mainData[i];
    const rowIndexForSheet = i + 1;
    processApprovalRow(rowData, rowIndexForSheet, mainSheet, approverDataMap);
  }
}

/**
 * Pre-loads all timestamp and notes data from every approver sheet into a single object for fast access.
 * @param {Spreadsheet} ss The active spreadsheet.
 * @param {Array<string>} approverCodes A list of all approver codes (e.g., ["VAN", "TYRON", ...]).
 * @return {Object} A nested object map: { approverCode: { refNo: { timestamp: Date, notes: string } } }
 */
function preloadApproverData(ss, approverCodes) {
  const dataMap = {};
  approverCodes.forEach(code => {
    const sheet = ss.getSheetByName(code);
    if (sheet) {
      dataMap[code] = {};
      const sheetData = sheet.getRange("A:J").getValues(); // Read all data once
      for (let i = 0; i < sheetData.length; i++) {
        const refNo = sheetData[i][9]; // Column J: Reference Number
        if (refNo) {
          dataMap[code][refNo] = {
            notes: sheetData[i][1] || null,     // Column B: Notes
            timestamp: sheetData[i][2] || null  // Column C: Timestamp
          };
        }
      }
    } else {
      Logger.log(`Warning: Sheet for approver code "${code}" not found.`);
    }
  });
  return dataMap;
}

/**
 * Processes a single row from the "Conso" sheet to determine if a PDF should be generated.
 * @param {Array} rowData The data for the current row.
 * @param {number} rowIndex The actual row number in the spreadsheet.
 * @param {Sheet} mainSheet The "Conso" sheet object.
 * @param {Object} approverDataMap The pre-loaded map of all approver data.
 */
function processApprovalRow(rowData, rowIndex, mainSheet, approverDataMap) {
  const status = rowData[CONFIG.columns.status];
  const pdfLink = rowData[CONFIG.columns.pdfLink];
  const refNo = rowData[CONFIG.columns.refNo];
  const logPrefix = `Row ${rowIndex} (Ref: ${refNo || 'N/A'}):`;

  if (!refNo || !status) {
    Logger.log(`${logPrefix} Skipping. Missing Reference Number or Status.`);
    return;
  }
  
  // --- DECISION LOGIC: Determine if and what type of PDF to generate ---
  let generatePdfType = null; // Can be "FINAL", "ONGOING", or null

  const allApproversInRow = rowData.slice(CONFIG.columns.approversStart, CONFIG.columns.approversEnd).filter(String);
  const approversWithoutTimestamp = allApproversInRow.filter(code => {
    return approverDataMap[code] && (!approverDataMap[code][refNo] || !approverDataMap[code][refNo].timestamp);
  });

  // Condition 1: Handle "APPROVED" status. Always generate a "FINAL" PDF.
  if (status === "APPROVED") {
    generatePdfType = "FINAL";
    Logger.log(`${logPrefix} Status is APPROVED. Queued for FINAL PDF generation.`);
  } 
  // Condition 2: Handle "PENDING" status.
  else if (status === "PENDING" && !pdfLink) {
    if (approversWithoutTimestamp.length === 1 && approversWithoutTimestamp[0] === "GMC") {
      generatePdfType = "ONGOING";
      Logger.log(`${logPrefix} Status is PENDING and GMC is the sole remainder. Queued for ONGOING PDF generation.`);
    } else {
      Logger.log(`${logPrefix} Skipping. Status is PENDING, but conditions for ONGOING PDF are not met.`);
    }
  } else {
     Logger.log(`${logPrefix} Skipping. Status is '${status}' and does not meet any generation criteria.`);
  }

  if (!generatePdfType) {
    return;
  }
  
  // --- PDF GENERATION PROCESS ---
  try {
    const folder = DriveApp.getFolderById(CONFIG.folderId);
    const subject = rowData[CONFIG.columns.subject];
    const departments = ["CGM","MOSD", "LEASING", "BCM", "RBG", "OD", "PROC"];

    const departmentMap = {};
    departments.forEach(d => departmentMap[d] = { subs: [], head: null });
    
    allApproversInRow.forEach(code => {
      if (code === "GMC") return;

      const entry = CONFIG.approverDetails[code];
      if (entry) {
        const fullEntry = { ...entry, code };
        if (entry.role === "head") {
          departmentMap[entry.department].head = fullEntry;
        } else {
          departmentMap[entry.department].subs.push(fullEntry);
        }
      }
    });

    const doc = DocumentApp.create(`Generated Approval - Row ${rowIndex}`);
    const body = doc.getBody();
    
    body.setMarginTop(21.6).setMarginBottom(21.6).setMarginLeft(21.6).setMarginRight(21.6);
    
    const header = doc.getHeader() || doc.addHeader();
    header.appendParagraph(refNo).setAlignment(DocumentApp.HorizontalAlignment.RIGHT).setFontSize(9);
    
    const statusNote = (generatePdfType === "FINAL") ? "Final Status" : "Ongoing Status";
    body.appendParagraph(statusNote).setAlignment(DocumentApp.HorizontalAlignment.CENTER).setBold(true).setFontSize(11);
    body.appendParagraph("");
    
    const description = (generatePdfType === "FINAL")
      ? "This document is the approval page for the memo with the foregoing details:"
      : "This memo is not yet approved. This page shows current status of the memo at the time of printing for reference or what ever purpose it may serve.";
    body.appendParagraph(description).setFontSize(7).setBold(true);
    body.appendParagraph("");
    
    var labels = ["Subject of Memo", "Date of Memo", "Upload Timestamp", "Preparer of Memo", "Preparer Email", "Uploader of Memo", "Uploader Email", "File link of Memo"];
    var values = [rowData[10], rowData[11], rowData[5], rowData[8], rowData[9], rowData[6], rowData[7], rowData[13]];
    for (var j = 0; j < values.length; j++) {
      var para = body.appendParagraph("");
      var value = values[j];
      var FONT_SIZE_SUBJECT = 9;
      var FONT_SIZE_DEFAULT = 7;
      if (labels[j] === "Subject of Memo") {
        para.appendText(labels[j] + ": ").setBold(true).setFontSize(FONT_SIZE_SUBJECT);
        para.appendText(String(value || "")).setBold(false).setFontSize(FONT_SIZE_SUBJECT);
      } else {
        para.appendText(labels[j] + ": ").setBold(true).setFontSize(FONT_SIZE_DEFAULT);
        if ((labels[j].includes("Timestamp") || labels[j].includes("Date")) && value) {
          para.appendText(Utilities.formatDate(new Date(value), Session.getScriptTimeZone(), "MMM d, yyyy HH:mm")).setBold(false).setFontSize(FONT_SIZE_DEFAULT);
        } else {
          para.appendText(String(value || "")).setBold(false).setFontSize(FONT_SIZE_DEFAULT);
        }
      }
    }

    var excludedValues = ["CAMSY","MIKEE","VAN","TYRON","MGL","JE","NOE","KMV","LDA","GMC","RCS","JAYE","JOY","ALEX","AU","BRIX","MAR","ANNALEE","ARRA","AIZELLE","DULCE","VIA","OAUIE","MICH","FATIMA","MELANIE","STEPH","PAT","ROSA","JANICE","EBA","DSM","JAC","DP","FA","DM","KL","JM","MA","JG", "NA"];
    var coverageValues = rowData.slice(14, 56).filter(v => v && !excludedValues.includes(String(v).trim()) && !String(v).includes('.pdf') && !String(v).includes('https')).join(", ");
    var propertyParagraph = body.appendParagraph("");
    propertyParagraph.appendText("Property/Coverage: ").setBold(true).setFontSize(7);
    propertyParagraph.appendText(coverageValues).setBold(false).setFontSize(7);
    body.appendParagraph("");

   var headerTable = body.appendTable();
    var headerRow = headerTable.appendTableRow();
    departments.forEach(dept => {
      // Append a new cell and set its content to the department name
      const cell = headerRow.appendTableCell(dept);
      
      // Set the background color on the entire cell
      cell.setBackgroundColor('#A9A9A9');
      
      // Center align the text and make it bold
      // We get the first child of the cell (which is the paragraph) to apply text-specific formatting
      cell.getChild(0).asParagraph().setAlignment(DocumentApp.HorizontalAlignment.CENTER).setBold(true);
    });
    headerTable.setBorderWidth(0);

    var contentTable = body.appendTable();
    var maxRows = Math.max(...departments.map(d => departmentMap[d].subs.length + (departmentMap[d].head ? 1 : 0)));

    for (var r = 0; r < maxRows; r++) {
      var tableRow = contentTable.appendTableRow();
      departments.forEach(dept => {
        var cell = tableRow.appendTableCell();
        var entry = (r < departmentMap[dept].subs.length) ? departmentMap[dept].subs[r] : ((r === departmentMap[dept].subs.length) ? departmentMap[dept].head : null);
        
        if (entry) {
          try {
            var blob = DriveApp.getFileById(entry.id).getBlob();
            cell.appendImage(blob).setWidth(50).setHeight(50).getParent().asParagraph().setAlignment(DocumentApp.HorizontalAlignment.CENTER);
            
            cell.appendParagraph(String(entry.name)).setBold(true).setFontSize(6).setAlignment(DocumentApp.HorizontalAlignment.CENTER);
            if (entry.position) {
              cell.appendParagraph(String(entry.position)).setBold(false).setFontSize(6).setAlignment(DocumentApp.HorizontalAlignment.CENTER);
            }
            
            const approvalData = approverDataMap[entry.code]?.[refNo];
            const timestamp = approvalData?.timestamp;
            const notes = approvalData?.notes;

            const timestampText = "Approved Date: " + (timestamp ? Utilities.formatDate(new Date(timestamp), Session.getScriptTimeZone(), "MMM d, yyyy HH:mm") : "N/A");
            cell.appendParagraph(timestampText).setBold(false).setFontSize(6).setAlignment(DocumentApp.HorizontalAlignment.CENTER);

            const notesText = "Remarks: " + (notes || "N/A");
            cell.appendParagraph(notesText).setFontSize(6).setBold(false).setAlignment(DocumentApp.HorizontalAlignment.CENTER);

          } catch (imgErr) {
            cell.appendParagraph("Image error").setAlignment(DocumentApp.HorizontalAlignment.CENTER);
            Logger.log(`${logPrefix} Image fetch error for ${entry.name}: ${imgErr.message}`);
          }
        }
      });
    }
    contentTable.setBorderWidth(0);
    
    doc.saveAndClose();
    
    const pdfBlob = DriveApp.getFileById(doc.getId()).getAs(MimeType.PDF);
    pdfBlob.setName(`${subject}.pdf`);
    const pdfFile = folder.createFile(pdfBlob);
    
    mainSheet.getRange(rowIndex, CONFIG.columns.pdfLink + 1).setValue(pdfFile.getUrl());
    DriveApp.getFileById(doc.getId()).setTrashed(true);
    
    Logger.log(`${logPrefix} Successfully generated ${generatePdfType} PDF.`);

  } catch (err) {
    Logger.log(`${logPrefix} FAILED. Error: ${err.message}\nStack: ${err.stack}`);
    mainSheet.getRange(rowIndex, CONFIG.columns.pdfLink + 1).setValue(`Error: ${err.message}`);
  }
}

