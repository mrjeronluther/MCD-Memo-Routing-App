/**
 * Main function to iterate through the "Conso" sheet and trigger the disapproval PDF generation process for each row.
 */
function generateDisapprovalPdfs() {
  // --- CONFIGURATION ---
  const CONSO_SHEET_NAME = "Conso";
  const HELPER_SHEET_NAME = "HelperCondition";
  const DESTINATION_FOLDER_ID = '1Du8Gw9M6bilmraQ5kLX7URKez8XxffMS'; // ID of the folder where PDFs will be saved

  // --- SPREADSHEET SETUP ---
  const ss = SpreadsheetApp.getActiveSpreadsheet();
  const mainSheet = ss.getSheetByName(CONSO_SHEET_NAME);
  const helperSheet = ss.getSheetByName(HELPER_SHEET_NAME);

  if (!mainSheet || !helperSheet) {
    Logger.log("Error: Could not find required sheets 'Conso' or 'HelperCondition'. Please check sheet names.");
    return;
  }

  const mainData = mainSheet.getDataRange().getValues();
  const helperData = helperSheet.getDataRange().getValues();

  // Create a map of the HelperCondition data for fast lookup.
  // Assumes reference number is in Column E (index 4) of HelperCondition.
  const helperMap = {};
  for (let j = 1; j < helperData.length; j++) { // Start from 1 to skip header
    const refNo = helperData[j][4];
    if (refNo) {
      
      // --- MODIFIED SECTION START ---
      // Get remarks from Column C (index 2) and Column D (index 3).
      const reasonFromC = helperData[j][2] || ''; 
      const reasonFromD = helperData[j][3] || '';
      
      // Combine them into a single string. The trim() function removes extra spaces.
      const combinedReason = (reasonFromC + ' ' + reasonFromD).trim();
      // --- MODIFIED SECTION END ---

      helperMap[refNo] = {
        rowIndex: j,
        status: helperData[j][0],      // Column A: Status
        reason: combinedReason,        // USE THE COMBINED REASON
        finalStatus: helperData[j][5]  // Column F: FINAL marker
      };
    }
  }

  // --- MAIN PROCESSING LOOP ---
  // Loop through main data from "Conso" sheet. Start from 1 to skip header.
  for (let i = 1; i < mainData.length; i++) {
    const currentRowData = mainData[i];
    const rowIndexForSheet = i + 1; // Human-readable row number (1-based)

    // Call the processing function for each row
    processRowForDisapproval(currentRowData, rowIndexForSheet, helperMap, ss, mainSheet, helperSheet, DESTINATION_FOLDER_ID);
  }
}


/**
 * Processes a single row from the "Conso" sheet to check if a disapproval PDF should be generated.
 * @param {Array} rowData The data for the current row from the "Conso" sheet.
 * @param {number} rowIndex The actual row number in the spreadsheet (for logging and writing back).
 * @param {Object} helperMap A map of the data from the "HelperCondition" sheet for quick lookups.
 * @param {Spreadsheet} ss The active spreadsheet instance.
 * @param {Sheet} mainSheet The "Conso" sheet object.
 * @param {Sheet} helperSheet The "HelperCondition" sheet object.
 * @param {string} folderId The ID of the destination Google Drive folder.
 */
function processRowForDisapproval(rowData, rowIndex, helperMap, ss, mainSheet, helperSheet, folderId) {
  const refNoFromConso = rowData[4]; // Column E: Reference Number
  const logPrefix = `Row ${rowIndex} (Ref: ${refNoFromConso || 'N/A'}):`;

  // --- SEQUENTIAL CHECKS ---

  // STEP 1: Check if a Reference Number exists in the "Conso" sheet.
  if (!refNoFromConso) {
    Logger.log(`${logPrefix} Skipping. No Reference Number found in Column E.`);
    return;
  }

  // STEP 2: Check if this Reference Number exists in the "HelperCondition" sheet.
  const helperInfo = helperMap[refNoFromConso];
  if (!helperInfo) {
    Logger.log(`${logPrefix} Skipping. Reference Number not found in 'HelperCondition' sheet.`);
    return;
  }

  // STEP 3: Check if the status is exactly "DISAPPROVED".
  if (helperInfo.status !== "DISAPPROVED") {
    Logger.log(`${logPrefix} Skipping. Status is '${helperInfo.status}', not 'DISAPPROVED'.`);
    return;
  }

  // STEP 4: Check if a reason/remark has been provided (now checks the combined value from C and D).
  if (!helperInfo.reason) {
    Logger.log(`${logPrefix} Skipping. Reason/Remarks columns (C and D) are blank in 'HelperCondition' sheet.`);
    return;
  }

  // STEP 5: Check if the PDF has already been generated (marked as "FINAL").
  if (helperInfo.finalStatus === "FINAL") {
    Logger.log(`${logPrefix} Skipping. Already marked as 'FINAL'.`);
    return;
  }

  // --- ALL CHECKS PASSED ---
  Logger.log(`${logPrefix} All conditions met. Starting PDF generation.`);

  try {
    const folder = DriveApp.getFolderById(folderId);

