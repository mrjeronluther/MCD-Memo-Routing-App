  }
  
  // --- Configuration ---
  const LOOKUP_VALUE_COLUMN = 5;      // Column E
  const SHEET_REFS_START_COLUMN = 12; // Column L
  const SHEET_REFS_END_COLUMN = 58;   // Column BF
  const resultColumnIndex = resultColumnLetter.toUpperCase().charCodeAt(0) - 64;
  
  console.time("Execution Time (findFirstDisapprovalReason)");

  try {
    const lastRow = sheet.getLastRow();
    if (lastRow < 2) {
      console.log("No data to process.");
      return;
    }

    // This list should contain all possible sheets that could ever be referenced.
    const validSheets = ["GMC", "RCS", "MGL", "KMV", "LDA", "JAYE", "BRIX", "JOY", "ALEX", "AU", "MAR", "EBA", "DSM", "JAC", "DP", "FA", "DM", "KL", "JM", "JG", "MA", "ANNALEE", "ARRA", "DULCE", "AIZELLE", "VIA", "OAUIE", "MICH", "FATIMA", "MELANIE", "STEPH", "PAT", "ROSA", "JANICE", "CAMSY", "MIKEE", "VANESSA", "TYRON"];

    // --- STEP 1: CACHE DATA FROM SOURCE SHEETS (Now includes Column B) ---
    console.log("Caching Status and Reason data from source sheets...");
    const sheetDataCache = {};
    for (const sheetName of validSheets) {
      const targetSheet = ss.getSheetByName(sheetName);
      if (!targetSheet) {
        console.warn(`Sheet "${sheetName}" not found. Skipping.`);
        continue;
      }
      const targetLastRow = targetSheet.getLastRow();
      if (targetLastRow < 1) continue;
      
      const targetData = targetSheet.getRange(1, 1, targetLastRow, 10).getValues(); // Read A:J
      
      // Create a map where key is the lookup value and value is an object {status, reason}
      const lookupMap = new Map();
      for (const row of targetData) {
        const lookupValue = row[9]; // Column J (index 9)
        if (lookupValue) {
          lookupMap.set(lookupValue, {
            status: row[0], // Column A (index 0)
            reason: row[1]  // Column B (index 1)
          });
        }
      }
      sheetDataCache[sheetName] = lookupMap;
    }
    console.log("Caching complete.");

    // --- STEP 2: READ MAIN SHEET DATA ---
    // Read from the first needed column (E) to the last needed column (BF)
    const rangeWidth = SHEET_REFS_END_COLUMN - LOOKUP_VALUE_COLUMN + 1;
    const mainData = sheet.getRange(2, LOOKUP_VALUE_COLUMN, lastRow - 1, rangeWidth).getValues();
    const finalResults = [];

    // --- STEP 3: PROCESS DATA IN MEMORY ---
    console.log("Processing data to find first disapproval reason...");
    const sheetRefSliceIndex = SHEET_REFS_START_COLUMN - LOOKUP_VALUE_COLUMN;

    for (const rowData of mainData) {
      const lookupVal = rowData[0]; // Value from Column E
      if (!lookupVal) {
        finalResults.push([""]);
        continue;
      }
      
      const sheetRefs = rowData.slice(sheetRefSliceIndex).filter(String);
      let disapprovalReason = ""; // Default to blank

      // Loop through the sheets listed for this row
      for (const sheetName of sheetRefs) {
        const lookupMap = sheetDataCache[sheetName];
        
        // Use the cache to check for disapproval
        if (lookupMap && lookupMap.has(lookupVal)) {
          const cachedData = lookupMap.get(lookupVal);
          if (cachedData.status === "DISAPPROVED") {
            disapprovalReason = cachedData.reason; // Found it! Get the reason from Col B.
            break; // Stop searching for this row, we have our answer.
          }
        }
      }
      finalResults.push([disapprovalReason]);
    }
    
    // --- STEP 4: WRITE DATA IN BULK ---
    if (finalResults.length > 0) {
      console.log(`Writing ${finalResults.length} results to column ${resultColumnLetter}...`);
      sheet.getRange(2, resultColumnIndex, finalResults.length, 1).setValues(finalResults);
