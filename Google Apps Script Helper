function getTimestampFromSheett(code, refNo, ss) {
  try {
    var sheet = ss.getSheetByName(code);
    if (!sheet) return null;
    var values = sheet.getRange("A:BK").getValues();
    for (var i = 0; i < values.length; i++) {
      if (values[i][9] == refNo) {
        return { status: values[i][0], timestamp: values[i][2] || null };
      }
    }
  } catch (e) {
    Logger.log("Timestamp fetch error from sheet " + code + ": " + e);
  }
  return null;
}

function getNotess(code, refNo, ss) {
  try {
    var sheet = ss.getSheetByName(code);
    if (!sheet) return null;
    var values = sheet.getRange("A:BM").getValues();
    for (var i = 0; i < values.length; i++) {
      if (values[i][9] == refNo) {
        return values[i][1] || null;
      }
    }
  } catch (e) {
    Logger.log("Notes fetch error from sheet " + code + ": " + e);
  }
  return null;
}

