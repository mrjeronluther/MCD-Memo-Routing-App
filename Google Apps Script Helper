function approvesda() {
  const ss = SpreadsheetApp.getActiveSpreadsheet();
  const mainSheet = ss.getSheetByName(CONFIG.sheetNames.main);
  if (!mainSheet) return;
  
  const mainData = mainSheet.getDataRange().getValues();
  const approverDataMap = preloadApproverData(ss, Object.keys(CONFIG.approverDetails));

  let creationCount = 0;

  for (let i = 1; i < mainData.length; i++) {
    // PREVENT DAILY QUOTA ERROR
    if (creationCount >= CONFIG.maxDocsToCreateInOneRun) {
      Logger.log("Stopping after " + creationCount + " PDFs to save daily quota. Run again to process more.");
      break; 
    }

    const rowData = mainData[i];
    const pdfLink = rowData[CONFIG.columns.pdfLink];
    const status = rowData[CONFIG.columns.status];

    // SKIP LOGIC: Do not call the document service if the row already has a link
    if (pdfLink && pdfLink.toString().trim() !== "") {
       continue;
    }

    const rowIndexForSheet = i + 1;
    const didCreate = processApprovalRow(rowData, rowIndexForSheet, mainSheet, approverDataMap);
    
    if (didCreate) {
      creationCount++;
    }
  }
}

function preloadApproverData(ss, approverCodes) {
  const dataMap = {};
  approverCodes.forEach(code => {
    const sheet = ss.getSheetByName(code);
    if (sheet) {
      dataMap[code] = {};
      const sheetData = sheet.getRange("A:J").getValues();
      for (let i = 0; i < sheetData.length; i++) {
        const refNo = sheetData[i][9]; // Col J
        if (refNo) {
          dataMap[code][refNo] = {
            notes: sheetData[i][1] || null,    // Column B: Remarks
            timestamp: sheetData[i][2] || null // Column C: Timestamp
          };
        }
      }
    }
  });
  return dataMap;
}

function processApprovalRow(rowData, rowIndex, mainSheet, approverDataMap) {
  const status = rowData[CONFIG.columns.status];
  const pdfLink = rowData[CONFIG.columns.pdfLink];
  const refNo = rowData[CONFIG.columns.refNo];

  if (!refNo || !status) return false;
  
  let generatePdfType = null;
  const allApproversInRow = rowData.slice(CONFIG.columns.approversStart, CONFIG.columns.approversEnd)
  .filter(code => code && CONFIG.approverDetails.hasOwnProperty(String(code).trim()));

  // Status Logic
  if (status === "APPROVED") {
    generatePdfType = "FINAL";
  } else if (status === "PENDING" && !pdfLink) {
    const approversWithoutTimestamp = allApproversInRow.filter(code => {
      return approverDataMap[code] && (!approverDataMap[code][refNo] || !approverDataMap[code][refNo].timestamp);
    });
    if (approversWithoutTimestamp.length === 1 && approversWithoutTimestamp[0] === "GMC") {
      generatePdfType = "ONGOING";
    }
  }

  if (!generatePdfType) return false;
  
  // PDF GENERATION START
  try {
    const folder = DriveApp.getFolderById(CONFIG.folderId);
    const subject = rowData[CONFIG.columns.subject];
    const departments = ["MOSD", "LEASING", "BCM", "RBG", "OD", "PROC"];
    const departmentMap = {};
    departments.forEach(d => departmentMap[d] = { subs: [], head: null });
    
    allApproversInRow.forEach(code => {
      if (code === "GMC") return;
      const entry = CONFIG.approverDetails[code];
      if (entry) {
        const fullEntry = { ...entry, code };
        if (entry.role === "head") departmentMap[entry.department].head = fullEntry;
        else departmentMap[entry.department].subs.push(fullEntry);
      }
    });

    const doc = DocumentApp.create(`Generated Approval - Row ${rowIndex}`);
    const body = doc.getBody();
    
    // Maintain 21.6 margin from original
    body.setMarginTop(21.6).setMarginBottom(21.6).setMarginLeft(21.6).setMarginRight(21.6);
    
    const header = doc.getHeader() || doc.addHeader();
    header.appendParagraph(refNo).setAlignment(DocumentApp.HorizontalAlignment.RIGHT).setFontSize(9);
    
    const statusNote = (generatePdfType === "FINAL") ? "Final Status" : "Ongoing Status";
    body.appendParagraph(statusNote).setAlignment(DocumentApp.HorizontalAlignment.CENTER).setBold(true).setFontSize(11);
    body.appendParagraph("");
    
    const description = (generatePdfType === "FINAL")
      ? "This document is the approval page for the memo with the foregoing details:"
      : "This memo is not yet approved. This page shows current status of the memo at the time of printing for reference or what ever purpose it may serve.";
    body.appendParagraph(description).setFontSize(7).setBold(true);
    body.appendParagraph("");
    
    // Formatting Header info exactly as original script
    var labels = ["Subject of Memo", "Date of Memo", "Upload Timestamp", "Preparer of Memo", "Preparer Email", "Uploader of Memo", "Uploader Email", "File link of Memo"];
    var values = [rowData[10], rowData[11], rowData[5], rowData[8], rowData[9], rowData[6], rowData[7], rowData[13]];
    
    for (var j = 0; j < values.length; j++) {
      var para = body.appendParagraph("");
      var value = values[j];
      var fontSize = (labels[j] === "Subject of Memo") ? 9 : 7;
      
      para.appendText(labels[j] + ": ").setBold(true).setFontSize(fontSize);
      if ((labels[j].includes("Timestamp") || labels[j].includes("Date")) && value) {
         para.appendText(Utilities.formatDate(new Date(value), Session.getScriptTimeZone(), "MMM d, yyyy HH:mm")).setBold(false).setFontSize(fontSize);
      } else {
         para.appendText(String(value || "")).setBold(false).setFontSize(fontSize);
      }
    }

    // Property / Coverage details logic
    // Automatically gets all codes from your CONFIG and adds standard ignores
var excludedValues = Object.keys(CONFIG.approverDetails).concat(["N/A", "NA", "DONE", "PENDING"]);
    var coverageValues = rowData.slice(14, 56).filter(v => v && !excludedValues.includes(String(v).trim()) && !String(v).includes('.pdf') && !String(v).includes('https')).join(", ");
    var propertyParagraph = body.appendParagraph("");
    propertyParagraph.appendText("Property/Coverage: ").setBold(true).setFontSize(7);
    propertyParagraph.appendText(coverageValues).setBold(false).setFontSize(7);
    body.appendParagraph("");

    // SIG TABLE HEADER - Colors and styles maintained
    var headerTable = body.appendTable();
    var headerRow = headerTable.appendTableRow();
    departments.forEach(dept => {
      const cell = headerRow.appendTableCell(dept);
      cell.setBackgroundColor('#A9A9A9'); // Original Grey color
      cell.getChild(0).asParagraph().setAlignment(DocumentApp.HorizontalAlignment.CENTER).setBold(true);
    });
    headerTable.setBorderWidth(0);

    // SIG TABLE CONTENT - Loop to generate images, names, notes, and dates
    var contentTable = body.appendTable();
    var maxRows = Math.max(...departments.map(d => departmentMap[d].subs.length + (departmentMap[d].head ? 1 : 0)));

    for (var r = 0; r < maxRows; r++) {
      var tableRow = contentTable.appendTableRow();
      departments.forEach(dept => {
        var cell = tableRow.appendTableCell();
        var entry = (r < departmentMap[dept].subs.length) ? departmentMap[dept].subs[r] : ((r === departmentMap[dept].subs.length) ? departmentMap[dept].head : null);
        
        if (entry) {
          try {
            var blob = DriveApp.getFileById(entry.id).getBlob();
            cell.appendImage(blob).setWidth(50).setHeight(50).getParent().asParagraph().setAlignment(DocumentApp.HorizontalAlignment.CENTER);
            
            cell.appendParagraph(String(entry.name)).setBold(true).setFontSize(6).setAlignment(DocumentApp.HorizontalAlignment.CENTER);
            if (entry.position) {
              cell.appendParagraph(String(entry.position)).setBold(false).setFontSize(6).setAlignment(DocumentApp.HorizontalAlignment.CENTER);
            }
            
            // Re-adding correctly pulled Remark and Timestamp details
            const dataRecord = approverDataMap[entry.code] ? approverDataMap[entry.code][refNo] : null;
            
            const tsVal = (dataRecord && dataRecord.timestamp) 
               ? Utilities.formatDate(new Date(dataRecord.timestamp), Session.getScriptTimeZone(), "MMM d, yyyy HH:mm") 
               : "N/A";
            cell.appendParagraph("Approved Date: " + tsVal).setBold(false).setFontSize(6).setAlignment(DocumentApp.HorizontalAlignment.CENTER);

            const noteVal = (dataRecord && dataRecord.notes) ? dataRecord.notes : "N/A";
            cell.appendParagraph("Remarks: " + noteVal).setFontSize(6).setBold(false).setAlignment(DocumentApp.HorizontalAlignment.CENTER);

          } catch (imgErr) {
            cell.appendParagraph("N/A").setAlignment(DocumentApp.HorizontalAlignment.CENTER);
          }
        }
      });
    }
    contentTable.setBorderWidth(0);
    
    doc.saveAndClose();
    
    // PDF Save and Sheet update
    const pdfBlob = DriveApp.getFileById(doc.getId()).getAs(MimeType.PDF);
    pdfBlob.setName(`${subject}.pdf`);
    const pdfFile = folder.createFile(pdfBlob);
    
    mainSheet.getRange(rowIndex, CONFIG.columns.pdfLink + 1).setValue(pdfFile.getUrl());
    DriveApp.getFileById(doc.getId()).setTrashed(true);
    
    return true; 

  } catch (err) {
    Logger.log(`Failed at Row ${rowIndex}: ${err.message}`);
    mainSheet.getRange(rowIndex, CONFIG.columns.pdfLink + 1).setValue(`Error: ${err.message}`);
    return false;
  }
}


