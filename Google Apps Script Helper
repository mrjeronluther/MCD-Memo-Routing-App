    SpreadsheetApp.getUi().alert(`An error occurred. Check logs for details. Error: ${e.message}`);
  } finally {
    console.timeEnd("Execution Time (findFirstDisapprovingSheet)");
  }
}

/**
 * A high-performance function to find the first "disapproval reason" from a series of sheets.
 * The disapproval reason is sourced from Column B of the target sheet.
 *
 * How it works:
 * 1.  Caches Data: It reads all potential source sheets and caches their key data:
 *     Column J (lookup ID), Column A (status), and Column B (reason). This data is stored
 *     in an efficient JavaScript Map for instant access.
 * 2.  Reads Main Sheet: It reads the lookup values (Col E) and sheet references (Cols L:BF) from
 *     the main sheet in one bulk operation.
 * 3.  Processes in Memory: It iterates through each row in memory. For each row, it checks its
 *     list of sheets, using the cache to find the first one with a "DISAPPROVED" status. When found,
 *     it grabs the corresponding reason from the cache and stops searching for that row.
 * 4.  Writes in Bulk: It writes all the collected reasons back to the specified result column
 *     in a single operation.
 *
 * @param {string} resultColumnLetter The column to write the results to (e.g., "D").
 */
function findFirstDisapprovalReason_Optimized(resultColumnLetter = 'D') {
  const ss = SpreadsheetApp.getActiveSpreadsheet();
  const mainSheetName = "Conso";
  const sheet = ss.getSheetByName(mainSheetName);

  if (!sheet) {
    SpreadsheetApp.getUi().alert(`Sheet "${mainSheetName}" not found!`);
