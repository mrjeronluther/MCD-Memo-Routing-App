function onOpen() {
  const ui = SpreadsheetApp.getUi();

  ui.createMenu('Generate Status')
    .addItem('Generate Final Status', 'checkApprovalStatus_Optimized')
    .addItem('Generate Who Disapproved', 'findFirstDisapprovingSheet_Optimized')
    .addItem('Generate Disapproved Remarks', 'findFirstDisapprovalReason_Optimized')
    .addToUi();
  
  ui.createMenu('Generate Approval/Disapproval Page')
    .addItem('Generate Final/Ongoing Comment Page', 'approvesda')
    .addItem('Generate Disapproval Comment Page', 'generateDisapprovalPdfs')
    .addItem('Email Sender(Approved)', 'sendApprovalEmails')
    .addItem('Email Sender(Dispproved)', 'senddispprovalEmails')
    .addItem('Update All Reviewer Statuses', 'processAllReviewerSheets')
    .addToUi();
}

// Final Status Runs Every Midnight to 1am
function runAutomatedProcess() {
  checkApprovalStatus_Optimized();
  Logger.log('Automated Final Status Tagging ran successfully at ' + new Date());
}

// Who Disapprove Runs Every 2am to 3am
