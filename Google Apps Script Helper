      const targetLastRow = targetSheet.getLastRow();
      if (targetLastRow < 1) continue;
      
      const targetData = targetSheet.getRange(1, 1, targetLastRow, 10).getValues(); // A to J
      const lookupMap = new Map();
      for (const row of targetData) {
        const lookupValue = row[9]; // Column J (index 9)
        const statusValue = row[0]; // Column A (index 0)
        if (lookupValue) {
          lookupMap.set(lookupValue, statusValue);
        }
      }
      sheetDataCache[sheetName] = lookupMap;
    }
    console.log("Caching complete.");

    // --- STEP 2: READ MAIN SHEET DATA ---
    // Read from the first relevant column (E) to the last (BP)
    const rangeWidth = SHEET_REFS_END_COLUMN - LOOKUP_VALUE_COLUMN + 1;
    const mainData = sheet.getRange(2, LOOKUP_VALUE_COLUMN, lastRow - 1, rangeWidth).getValues();
    const finalResults = [];

    // --- STEP 3: PROCESS DATA IN MEMORY ---
    console.log("Processing data to find first disapproving sheet...");
    for (const rowData of mainData) {
      const lookupVal = rowData[0]; // Value from Column E (index 0 in our rowData array)
      if (!lookupVal) {
        finalResults.push([""]); // No lookup value, so result is blank
        continue;
      }
      
      // Get the sheet names from this row's data (P to BP) and filter out empty cells
      // Index for P in rowData = P(16) - E(5) = 11
      const sheetRefs = rowData.slice(SHEET_REFS_START_COLUMN - LOOKUP_VALUE_COLUMN).filter(String);
      
      let disapprovingSheet = ""; // Default to blank

      // Loop through the sheets for this specific row
      for (const sheetName of sheetRefs) {
        const lookupMap = sheetDataCache[sheetName];
        // Check if the sheet exists in cache AND the value exists in the map
        if (lookupMap && lookupMap.has(lookupVal)) {
          const status = lookupMap.get(lookupVal);
          if (status === "DISAPPROVED") {
            disapprovingSheet = sheetName;
            break; // Found the first one, no need to check other sheets for this row.
          }
        }
      }
      finalResults.push([disapprovingSheet]);
    }
    
    // --- STEP 4: WRITE DATA IN BULK ---
    if (finalResults.length > 0) {
