        // Handle case where there are no "core" sheets available for this row, but maybe others
        const allPending = allResults.every(res => res === "PENDING" || res === "");
        const anyApproved = allResults.some(res => res === "APPROVED");
        if (!anyApproved && allPending) {
             finalStatus = "PENDING";
        } else if (allResults.length > 0 && allResults.every(res => res === "APPROVED")) {
             // Optional: If you want non-core to also trigger approval if all are approved
             finalStatus = "APPROVED";
        } else {
             finalStatus = "PENDING";
        }
      }
      
      finalStatuses.push([finalStatus]); // Add to our results array
    }

    // --- STEP 4: WRITE DATA IN BULK ---
    if (finalStatuses.length > 0) {
      console.log("Writing results back to the sheet...");
      sheet.getRange(2, 1, finalStatuses.length, 1).setValues(finalStatuses);
      console.log("Update complete!");
    } else {
      console.log("No results to write.");
    }
    
  } catch (e) {
    // Log any errors that occur
    console.error(`An error occurred: ${e.message}\nStack: ${e.stack}`);
    SpreadsheetApp.getUi().alert(`An error occurred. Check logs for details. Error: ${e.message}`);
  } finally {
    // Log the total time taken
    console.timeEnd("Execution Time");
  }
}


/**
 * A high-performance function to find the first "disapproving" sheet for each row.
 * This script is an optimized replacement for the complex array formula.
 *
 * How it works:
 * 1.  Caches Data: It reads all potential source sheets (defined in `validSheets`) and caches
 *     their lookup data (Column J and Column A) into an efficient JavaScript Map. This is the most
 *     important optimization step.
 * 2.  Reads Main Sheet: It reads the lookup values (Col E) and sheet references (Cols P:BP) from
 *     the main sheet in a single bulk operation.
 * 3.  Processes in Memory: It iterates through each row of data in memory. For each row, it loops
 *     through its specified sheets and uses the fast cache to find the first one with a
 *     "DISAPPROVED" status. It then stops searching for that row and moves to the next.
 * 4.  Writes in Bulk: It writes all the results back to the sheet in a single `setValues()` call.
 *
 * @param {string} resultColumnLetter The column to write the results to (e.g., "C").
 */
function findFirstDisapprovingSheet_Optimized(resultColumnLetter = 'C') {
  const ss = SpreadsheetApp.getActiveSpreadsheet();
  const mainSheetName = "Conso"; // The name of your main sheet
  const sheet = ss.getSheetByName(mainSheetName);

  if (!sheet) {
    SpreadsheetApp.getUi().alert(`Sheet "${mainSheetName}" not found!`);
    return;
  }
  
  // --- Configuration ---
  const LOOKUP_VALUE_COLUMN = 5; // Column E
  const SHEET_REFS_START_COLUMN = 16; // Column P
  const SHEET_REFS_END_COLUMN = 68; // Column BP
  const resultColumnIndex = resultColumnLetter.toUpperCase().charCodeAt(0) - 64;

  console.time("Execution Time (findFirstDisapprovingSheet)");
  
  try {
    const lastRow = sheet.getLastRow();
    if (lastRow < 2) {
      console.log("No data to process.");
      return;
    }
    
    // Using the same sheet list as the previous script for consistency.
    // This is more efficient than scanning the sheet for all unique names.
    const validSheets = ["GMC", "RCS", "MGL", "KMV", "LDA", "JAYE", "BRIX", "JOY", "ALEX", "AU", "MAR", "EBA", "DSM", "JAC", "DP", "FA", "DM", "KL", "JM", "JG", "MA", "ANNALEE", "ARRA", "DULCE", "AIZELLE", "VIA", "OAUIE", "MICH", "FATIMA", "MELANIE", "STEPH", "PAT", "ROSA", "JANICE", "CAMSY", "MIKEE", "VANESSA", "TYRON"];

    // --- STEP 1: CACHE DATA (Identical to the previous function's caching logic) ---
    console.log("Caching data from source sheets...");
    const sheetDataCache = {};
    for (const sheetName of validSheets) {
      const targetSheet = ss.getSheetByName(sheetName);
      if (!targetSheet) continue;

      const targetLastRow = targetSheet.getLastRow();
      if (targetLastRow < 1) continue;
      
      const targetData = targetSheet.getRange(1, 1, targetLastRow, 10).getValues(); // A to J
      const lookupMap = new Map();
      for (const row of targetData) {
        const lookupValue = row[9]; // Column J (index 9)
        const statusValue = row[0]; // Column A (index 0)
        if (lookupValue) {
          lookupMap.set(lookupValue, statusValue);
        }
      }
      sheetDataCache[sheetName] = lookupMap;
    }
    console.log("Caching complete.");

    // --- STEP 2: READ MAIN SHEET DATA ---
    // Read from the first relevant column (E) to the last (BP)
    const rangeWidth = SHEET_REFS_END_COLUMN - LOOKUP_VALUE_COLUMN + 1;
    const mainData = sheet.getRange(2, LOOKUP_VALUE_COLUMN, lastRow - 1, rangeWidth).getValues();
    const finalResults = [];

    // --- STEP 3: PROCESS DATA IN MEMORY ---
    console.log("Processing data to find first disapproving sheet...");
    for (const rowData of mainData) {
      const lookupVal = rowData[0]; // Value from Column E (index 0 in our rowData array)
      if (!lookupVal) {
        finalResults.push([""]); // No lookup value, so result is blank
        continue;
      }
      
      // Get the sheet names from this row's data (P to BP) and filter out empty cells
      // Index for P in rowData = P(16) - E(5) = 11
      const sheetRefs = rowData.slice(SHEET_REFS_START_COLUMN - LOOKUP_VALUE_COLUMN).filter(String);
      
      let disapprovingSheet = ""; // Default to blank

      // Loop through the sheets for this specific row
      for (const sheetName of sheetRefs) {
        const lookupMap = sheetDataCache[sheetName];
        // Check if the sheet exists in cache AND the value exists in the map
        if (lookupMap && lookupMap.has(lookupVal)) {
          const status = lookupMap.get(lookupVal);
          if (status === "DISAPPROVED") {
            disapprovingSheet = sheetName;
            break; // Found the first one, no need to check other sheets for this row.
          }
        }
      }
      finalResults.push([disapprovingSheet]);
    }
    
    // --- STEP 4: WRITE DATA IN BULK ---
    if (finalResults.length > 0) {
      console.log(`Writing ${finalResults.length} results to column ${resultColumnLetter}...`);
      sheet.getRange(2, resultColumnIndex, finalResults.length, 1).setValues(finalResults);
      console.log("Update complete!");
    } else {
      console.log("No results to write.");
    }
    
  } catch (e) {
    console.error(`An error occurred: ${e.message}\nStack: ${e.stack}`);
    SpreadsheetApp.getUi().alert(`An error occurred. Check logs for details. Error: ${e.message}`);
  } finally {
    console.timeEnd("Execution Time (findFirstDisapprovingSheet)");
  }
}

/**
 * A high-performance function to find the first "disapproval reason" from a series of sheets.
 * The disapproval reason is sourced from Column B of the target sheet.
 *
 * How it works:
 * 1.  Caches Data: It reads all potential source sheets and caches their key data:
 *     Column J (lookup ID), Column A (status), and Column B (reason). This data is stored
 *     in an efficient JavaScript Map for instant access.
 * 2.  Reads Main Sheet: It reads the lookup values (Col E) and sheet references (Cols L:BF) from
 *     the main sheet in one bulk operation.
 * 3.  Processes in Memory: It iterates through each row in memory. For each row, it checks its
 *     list of sheets, using the cache to find the first one with a "DISAPPROVED" status. When found,
 *     it grabs the corresponding reason from the cache and stops searching for that row.
 * 4.  Writes in Bulk: It writes all the collected reasons back to the specified result column
 *     in a single operation.
 *
 * @param {string} resultColumnLetter The column to write the results to (e.g., "D").
 */
function findFirstDisapprovalReason_Optimized(resultColumnLetter = 'D') {
  const ss = SpreadsheetApp.getActiveSpreadsheet();
