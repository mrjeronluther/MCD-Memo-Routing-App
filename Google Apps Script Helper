      for (const sheetName of sheetRefs) {
        const lookupMap = sheetDataCache[sheetName];
        
        // Use the cache to check for disapproval
        if (lookupMap && lookupMap.has(lookupVal)) {
          const cachedData = lookupMap.get(lookupVal);
          if (cachedData.status === "DISAPPROVED") {
            disapprovalReason = cachedData.reason; // Found it! Get the reason from Col B.
            break; // Stop searching for this row, we have our answer.
          }
        }
      }
      finalResults.push([disapprovalReason]);
    }
    
    // --- STEP 4: WRITE DATA IN BULK ---
    if (finalResults.length > 0) {
      console.log(`Writing ${finalResults.length} results to column ${resultColumnLetter}...`);
      sheet.getRange(2, resultColumnIndex, finalResults.length, 1).setValues(finalResults);
